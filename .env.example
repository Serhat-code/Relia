# Relia — variables d'environnement. Copier vers .env.local (jamais commité) et renseigner.

# URL publique de l'application (liens des e-mails d'authentification).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — projet en région UE (Paris, eu-west-3). En local : valeurs affichées par `npm run db:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (contourne la RLS) : serveur uniquement, jamais préfixée NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Connexion de la boîte d'envoi du client (palier 9) — applications OAuth de Relia.
# Google Cloud : identifiants OAuth « Application Web », API Gmail activée,
# URI de redirection : <NEXT_PUBLIC_SITE_URL>/app/boite-mail/retour/google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Microsoft Entra : inscription d'application « comptes professionnels et personnels »,
# URI de redirection Web : <NEXT_PUBLIC_SITE_URL>/app/boite-mail/retour/microsoft
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Rédaction assistée par IA (palier 10) — Mistral, hébergé dans l'UE. Sans clé : les modèles tels quels.
MISTRAL_API_KEY=
# Crons Vercel (palier 10) : secret transmis par Vercel dans l'en-tête Authorization.
CRON_SECRET=

# Abonnement à Relia (palier 13) — Stripe encaisse uniquement l'abonnement, jamais les règlements des clients.
# Sans clé : l'essai de 14 jours suit son cours et le bouton d'abonnement explique que le paiement est indisponible.
STRIPE_SECRET_KEY=
# Point de terminaison du webhook : <NEXT_PUBLIC_SITE_URL>/api/stripe/webhook
# Événements : checkout.session.completed, customer.subscription.created/updated/deleted/paused/resumed
STRIPE_WEBHOOK_SECRET=
# Prix mensuels (identifiants price_…) des offres Essentiel (29 €), Pro (49 €) et Business (79 €), hors taxes.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
# « true » si Stripe Tax est activé (TVA calculée par Stripe) ; sinon, configurer la TVA dans les prix.
STRIPE_AUTOMATIC_TAX=false
